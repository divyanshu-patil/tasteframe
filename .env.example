# Tasteframe — environment template. Placeholders only; never commit real values.
# Copy the API block to apps/api/.env and the web block to apps/web/.env.local.

# ───────────── apps/api/.env (FastAPI, server-only secrets) ─────────────
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
# Browser-reachable base URL of this API (used for dev local-upload URLs only).
PUBLIC_API_URL=http://localhost:8000
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]
# Long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=replace-with-a-long-random-string

# Qloo (hackathon keys only work against the hackathon host).
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=8
QLOO_MAX_RETRIES=2

# Storage: `local` (dev, writes to apps/api/.uploads) or `s3` (required in production).
STORAGE_BACKEND=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Prefer an IAM role on the host; set keys only if the host has no role support.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_TTL_SECONDS=300
S3_UPLOAD_MAX_BYTES=10485760

# Track metadata fallback (artist comes from Qloo): itunes | none
MUSIC_METADATA_PROVIDER=itunes

RATE_LIMIT_PRESIGN_PER_10MIN=20
RATE_LIMIT_ANALYSIS_PER_10MIN=12
RATE_LIMIT_SEARCH_PER_MIN=40

# Optional, not used by the guest MVP (see supabase/schema.sql + README).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ───────────── apps/web/.env.local (Next.js) ─────────────
# Server-only: where Next.js proxies /api/*. Never prefix secrets with NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:8000
# Public, non-secret: client-side size hint; must match S3_UPLOAD_MAX_BYTES.
NEXT_PUBLIC_UPLOAD_MAX_MB=10
