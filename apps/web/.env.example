# apps/web/.env.local — Next.js. Copy to apps/web/.env.local.
# Server-only: target of the /api/* rewrite (FastAPI base URL). Not exposed to the browser.
API_BASE_URL=http://127.0.0.1:8000
# Public, non-secret: client-side upload size hint in MB (match S3_UPLOAD_MAX_BYTES).
NEXT_PUBLIC_UPLOAD_MAX_MB=10
# Supabase Auth (login to save Stories, add favourites, pick songs). Project URL + PUBLISHABLE key
# only (sb_publishable_…), designed to be public. Never put the secret/service-role key or
# DATABASE_URL here. Google login: enable Authentication → Providers → Google in Supabase (Google
# Cloud OAuth client; its redirect URI is https://<project>.supabase.co/auth/v1/callback) and add
# <each app origin>/auth/callback to Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site address for email-confirmation links (also add it to Supabase → Authentication →
# URL Configuration → Redirect URLs). Defaults to wherever the app is running.
NEXT_PUBLIC_SITE_URL=https://tasteframe.vercel.app
# No AWS or Qloo keys here: the browser only talks to the API.
