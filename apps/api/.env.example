# apps/api/.env — FastAPI (server-only secrets). Copy to apps/api/.env and fill in.
# Never commit the real file; never put these in NEXT_PUBLIC_* variables.

ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
# Browser-reachable API URL (only used for dev `local` storage upload links).
PUBLIC_API_URL=http://localhost:8000
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]
# Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating it signs out guests and orphans their saved Stories.
SESSION_SECRET=replace-with-a-long-random-string

# ── Qloo (hackathon keys only work on the hackathon host) ──
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=8
QLOO_MAX_RETRIES=2

# ── AWS S3 (private bucket) ── set STORAGE_BACKEND=local to develop without AWS.
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Leave both empty when the host provides an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_TTL_SECONDS=300
S3_UPLOAD_MAX_BYTES=10485760

# ── Supabase (saved Stories; feature is off while these are empty) ──
# Project Settings → API Keys: Project URL + the PUBLISHABLE key (sb_publishable_…).
# It maps to the `anon` role; supabase/schema.sql makes the tf_* functions the only access path.
# Optional, setup only: Postgres connection string (Connect → pooler) used by supabase/apply.py
# to apply schema.sql. The app never reads it. URL-encode special characters in the password.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=6
# Limits live in SQL: 20 Stories per browser, 7-day retention (S3 `saved/` lifecycle: 8 days).

# ── Image reasoning (optional): vision LLM on Ollama Cloud (ollama.com → Settings → API keys) ──
# Off while OLLAMA_API_KEY is empty. A downscaled, EXIF-stripped copy of the photo is sent;
# Ollama states cloud prompts aren't used for training. qwen3-vl:235b was retired (2026-06-16).
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_TIMEOUT_SECONDS=25

# ── Music track metadata (artist always comes from Qloo): itunes | none ──
MUSIC_METADATA_PROVIDER=itunes

# ── Abuse limits ──
RATE_LIMIT_PRESIGN_PER_10MIN=20
RATE_LIMIT_ANALYSIS_PER_10MIN=12
RATE_LIMIT_SEARCH_PER_MIN=40

OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3-vl:235b:cloud