{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "API_BASE_URL",
        "NEXT_PUBLIC_UPLOAD_MAX_MB",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
      ],
      "passThroughEnv": [
        "NEXT_DIST_DIR"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_HOST",
        "API_PORT",
        "API_BASE_URL",
        "NEXT_PUBLIC_UPLOAD_MAX_MB",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
      ],
      "passThroughEnv": [
        "ENVIRONMENT",
        "SESSION_SECRET",
        "STORAGE_BACKEND",
        "QLOO_*",
        "AWS_*",
        "S3_*",
        "SUPABASE_*",
        "CORS_ORIGINS",
        "PUBLIC_API_URL",
        "MUSIC_METADATA_PROVIDER",
        "RATE_LIMIT_*",
        "OLLAMA_*"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
